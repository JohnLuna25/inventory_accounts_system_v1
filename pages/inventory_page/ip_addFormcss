/* Modal overlay */

.modal-content {
  background: white;
  width: 400px;
  padding: 20px;
  border-radius: 5px;

  /* Make modal taller vertically */
}

/* Form styling */

.modal-content label {
  font-weight: bold;
}

.modal-content input,
.modal-content select,
.modal-content textarea {
  padding: 5px;
  border: 1px solid #ccc;
  border-radius: 3px;
  width: 100%;
  box-sizing: border-box;
}

.modal-content textarea {
  min-height: 60px;
}

.modal-content button {
  padding: 8px 16px;
  border-radius: 4px;
  border: none;
  cursor: pointer;
}

.modal-content button[type="submit"] {
  background-color: #0b63c4;
  color: white;
  margin-top: 40px;
  width: 190px;
}

.modal-content button[type="button"] {
  background-color: #ccc;
  margin-top: 40px;
  width: 190px;
}

/* Form rows alignment */
.modal-content .form-row {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

/* Labels on the left */
.modal-content .form-row label {
  width: 180px; /* fixed width for labels */
  text-align: left;
  margin-right: 10px;
  font-weight: bold; /* keeps original style */
}

.modal-content .form-row select {
  flex: 1;
  text-align: center;
  padding: 5px;
  border: 1px solid #ccc;
  border-radius: 3px;
  box-sizing: border-box;
}

/* Inputs centered horizontally */
.modal-content .form-row input,
.modal-content .form-row select,
.modal-content .form-row textarea {
  flex: 1; /* take remaining space */
  text-align: center; /* center input text */
  padding: 5px;
  border: 1px solid #ccc;
  border-radius: 3px;
  box-sizing: border-box;
}

.modal-content .form-row textarea {
  min-height: 60px;
}

/* Inventory table */
.inventory-table {
  width: 95%;
  margin: 20px auto;
  border-collapse: collapse;
  text-align: center;
}

.inventory-table th {
  background: #0b63c4;
  color: #fff;
  padding: 8px;
}

.inventory-table td {
  padding: 6px;
  border: 1px solid #ddd;
}

.action-buttons {
  display: flex; /* place children in a row */
  gap: 5px; /* space between buttons */
  justify-content: center; /* center the buttons in the cell */
  align-items: center; /* vertically center if needed */
}

.action-buttons button {
  padding: 5px 10px;
  border-radius: 3px;
  border: none;
  cursor: pointer;
  width: 70px; /* same width for all buttons */
  box-sizing: border-box;
  text-align: center;
}

/* Delete button style */
.action-buttons button.delete {
  background: #f44336;
  color: white;
}

/* Edit button style */
.action-buttons button.edit {
  background: #0b63c4;
  color: white;
}

/* Make form inline so it doesn't break the row */
.action-buttons form {
  display: inline-block;
  margin: 0;
}
